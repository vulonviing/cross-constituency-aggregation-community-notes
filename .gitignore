# GitHub-too-large project data
# ---------------------------------------------------------------------------
# Canonical raw inputs are local-only.
raw/*.tsv
raw/*.parquet
raw/*.csv
raw/*.gz

# Large interim ratings files: exceed GitHub LFS 2 GB limit.
# They are mirrored by scripts/fetch_interim_from_hf.sh.
data/interim/ratings_filtered.parquet
data/interim/ratings_clustered.parquet

# Full master table is reproducible from raw inputs and remains local.
data/master_full.parquet

# Cluster/job-submission docs kept local only; not part of the public checkout.
